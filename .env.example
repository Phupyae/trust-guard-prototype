# Copy this file to .env and fill in ONE of the keys below. Never commit .env.

# Which LLM backend to use:
#   gemini = Google Gemini, FREE tier (key from https://aistudio.google.com)
#   claude = Anthropic Claude, paid per use (key from https://console.anthropic.com)
#   mock   = offline keyword heuristics for development only, NOT real verification
LLM_PROVIDER=gemini

GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-haiku-5-5

# Agent 1 (Banking AI Assistant), simulating a typical cost-tuned deployed chatbot.
# AGENT1_MODEL: empty = provider's smallest model (gemini-3.5-flash-lite / claude-haiku-5-5)
# AGENT1_KB_SCOPE: all (incl. superseded policy + unofficial FAQ page) | approved | none
# AGENT1_TOP_K: passages it reads per question (default 2)
AGENT1_MODEL=
AGENT1_KB_SCOPE=all
AGENT1_TOP_K=2

# Embedding model for evidence retrieval (downloaded once from Hugging Face, ~90MB)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
