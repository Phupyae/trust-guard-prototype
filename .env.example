# Copy this file to .env and fill in ONE key. Never commit .env.

# Provider for BOTH agents (same provider, different model tiers):
#   gemini = Google Gemini (key from https://aistudio.google.com)
#   claude = Anthropic Claude (key from https://console.anthropic.com)
#   mock   = offline keyword heuristics for development only, NOT real verification
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Two models (mentor guidance): Agent 1 on an older/cheaper model, TrustGuard on a newer/stronger one.
# Leave empty for the free-tier defaults: gemini-3.5-flash-lite (TrustGuard) / gemini-3.1-flash-lite (Agent 1)
#   Paid key, full tier split: TRUSTGUARD_MODEL=gemini-3.8-flash  AGENT1_MODEL=gemini-3.5-flash-lite
#   Claude: claude-sonnet-5-5 (TrustGuard) / claude-haiku-5-5 (Agent 1)
TRUSTGUARD_MODEL=
AGENT1_MODEL=

# Agent 1: what it reads and how much
# all = the same policy repository as TrustGuard, incl. superseded versions (default) | approved | none
AGENT1_KB_SCOPE=all
AGENT1_TOP_K=2

# Re-check method C (entailment model, ~280 MB download on first run). false = skip it.
ENABLE_NLI=true

# Search model (downloaded once from Hugging Face, ~90 MB)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
