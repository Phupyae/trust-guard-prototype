# Copy this file to .env and fill in your key. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which LLM backend to use: "claude" (real) or "mock" (offline dev only, NOT real verification)
LLM_PROVIDER=claude

# Cheap + fast by default. Switch to claude-sonnet-5-5 if verification quality isn't good enough.
CLAUDE_MODEL=claude-haiku-5-5

# Embedding model for evidence retrieval (downloaded once from Hugging Face, ~90MB)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
